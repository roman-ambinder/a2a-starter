<?xml version="1.0" encoding="utf-8"?>
<!-- Feed for building the samples on packages (eng/build-samples-on-packages.sh): the packages from 'dotnet pack' plus nuget.org.
     Relative paths are resolved against the folder of this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
