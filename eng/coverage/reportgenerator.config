# ReportGenerator arguments for the CI coverage report (one option per line, read by eng/coverage/report.sh).
# Exclusions only: generated code, proto output, source-generated JSON, samples/ and tests/. Nothing else is excluded.
-reporttypes:Html;MarkdownSummaryGithub;Cobertura
-assemblyfilters:+Ambinder.A2A.*;-*.Tests;-Ambinder.A2A.TestHarness;-Ambinder.A2A.Tck.Sut;-Ambinder.A2A.Samples.*
-classfilters:-Ambinder.A2A.Grpc.*;-*GeneratedRegex*;-*JsonContext*;-*.A2aReflection;-Grpc.Core.*;-Google.Protobuf.*
-filefilters:-*/obj/*;-*/samples/*;-*/tests/*;-*.g.cs;-*.g.i.cs;-*.generated.cs;-*/Grpc/A2a*.cs
-riskhotspotassemblyfilters:-*
