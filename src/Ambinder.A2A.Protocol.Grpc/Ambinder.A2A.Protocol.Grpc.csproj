<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Adds google/api/*.proto from Google.Api.CommonProtos to the protoc import path. -->
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ambinder.A2A.Protocol/Ambinder.A2A.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with Ambinder.A2A.AspNetCore.Grpc (which compiles it internal). Public here until the client split removes this project. -->
    <Compile Include="../Grpc.Shared/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../proto/a2a.proto" ProtoRoot="../../proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
