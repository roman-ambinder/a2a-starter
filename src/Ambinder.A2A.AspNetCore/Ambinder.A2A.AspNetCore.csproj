<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>ASP.NET Core hosting for the Ambinder.A2A server: JSON-RPC, REST and SSE endpoints, agent card endpoints, MapA2A and AddA2AServer.</Description>
    <PackageTags>$(PackageTags);server;rest;sse;minimal-api</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ambinder.A2A.Server/Ambinder.A2A.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internal helper compiled into each package that needs it (spec 01 rule 10), not shared through InternalsVisibleTo. -->
    <Compile Include="../Shared/RequestValidator.cs" Link="Shared/RequestValidator.cs" />
    <Compile Include="../Shared/InternalServiceKeys.cs" Link="Shared/InternalServiceKeys.cs" />
    <Compile Include="../Shared/TransportErrors.cs" Link="Shared/TransportErrors.cs" />
    <Compile Include="../Shared/TransportRequest.cs" Link="Shared/TransportRequest.cs" />
    <Compile Include="../Shared/RequestValidation.cs" Link="Shared/RequestValidation.cs" />
    <Compile Include="../Shared/ServiceParameters.cs" Link="Shared/ServiceParameters.cs" />
    <Compile Include="../Shared/ErrorDetailsFlattener.cs" Link="Shared/ErrorDetailsFlattener.cs" />
    <Compile Include="../Shared/AgentCardETag.cs" Link="Shared/AgentCardETag.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ambinder.A2A.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Ambinder.A2A.Integration.Tests" />
  </ItemGroup>
</Project>
