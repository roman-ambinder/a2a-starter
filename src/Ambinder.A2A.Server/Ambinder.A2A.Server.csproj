<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Host-neutral A2A v1.0 server core for .NET: agent handlers, task manager, event streaming, push notifications and store and authorization extension points. No ASP.NET Core dependency.</Description>
    <PackageTags>$(PackageTags);server;task-manager;push-notifications</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dependency floor (spec 01 rule 7): the lowest .NET 10 version; Directory.Packages.props keeps the newest for tests and samples. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" VersionOverride="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ambinder.A2A.Protocol/Ambinder.A2A.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internal helper compiled into each package that needs it (spec 01 rule 10), not shared through InternalsVisibleTo. -->
    <Compile Include="../Shared/RequestValidator.cs" Link="Shared/RequestValidator.cs" />
    <Compile Include="../Shared/InternalServiceKeys.cs" Link="Shared/InternalServiceKeys.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ambinder.A2A.Server.Tests" />
    <InternalsVisibleTo Include="Ambinder.A2A.Integration.Tests" />
  </ItemGroup>
</Project>
