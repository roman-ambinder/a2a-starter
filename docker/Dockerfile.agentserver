# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Restore first (own layer) so source edits do not re-download packages.
COPY Directory.Build.props Directory.Packages.props global.json Ambinder.A2A.slnx ./
COPY proto/ proto/
COPY src/Directory.Build.props src/
COPY samples/Directory.Build.props samples/
COPY src/Ambinder.A2A.Protocol/Ambinder.A2A.Protocol.csproj src/Ambinder.A2A.Protocol/
COPY src/Ambinder.A2A.Server/Ambinder.A2A.Server.csproj src/Ambinder.A2A.Server/
COPY src/Ambinder.A2A.AspNetCore/Ambinder.A2A.AspNetCore.csproj src/Ambinder.A2A.AspNetCore/
COPY src/Ambinder.A2A.AspNetCore.Grpc/Ambinder.A2A.AspNetCore.Grpc.csproj src/Ambinder.A2A.AspNetCore.Grpc/
COPY src/Ambinder.A2A.Client/Ambinder.A2A.Client.csproj src/Ambinder.A2A.Client/
COPY src/Ambinder.A2A.Client.Grpc/Ambinder.A2A.Client.Grpc.csproj src/Ambinder.A2A.Client.Grpc/
COPY src/Ambinder.A2A.Client.Entra/Ambinder.A2A.Client.Entra.csproj src/Ambinder.A2A.Client.Entra/
COPY samples/SampleTelemetry/SampleTelemetry.csproj samples/SampleTelemetry/
COPY samples/AgentServer/AgentServer.csproj samples/AgentServer/
RUN dotnet restore samples/AgentServer/AgentServer.csproj
COPY . .
RUN dotnet publish samples/AgentServer/AgentServer.csproj -c Release --no-restore -o /out \
    && test -f /out/agentserver-config/appsettings.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# curl is only for the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# The publish output keeps agentserver-config/appsettings*.json, which AgentServer uses as its content root.
COPY --from=build /out .
# Kestrel listens on the ports of A2A:PublicBaseUrl / A2A:GrpcPorts; any host other than localhost/IP binds all interfaces.
# No ASPNETCORE_ENVIRONMENT here: the image runs as Production unless the deployment says otherwise (compose sets Development).
EXPOSE 5200 5201 5202 5203 5204
USER app
ENTRYPOINT ["dotnet", "Ambinder.A2A.Samples.AgentServer.dll"]
