# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Restore first (own layer) so source edits do not re-download packages.
COPY Directory.Build.props Directory.Packages.props global.json A2A.Reference.slnx ./
COPY proto/ proto/
COPY src/A2A.Protocol/A2A.Protocol.csproj src/A2A.Protocol/
COPY src/A2A.Protocol.Grpc/A2A.Protocol.Grpc.csproj src/A2A.Protocol.Grpc/
COPY src/A2A.Server/A2A.Server.csproj src/A2A.Server/
COPY src/A2A.Client/A2A.Client.csproj src/A2A.Client/
COPY samples/AgentClient/AgentClient.csproj samples/AgentClient/
RUN dotnet restore samples/AgentClient/AgentClient.csproj
COPY . .
RUN dotnet publish samples/AgentClient/AgentClient.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
COPY --from=build /out .
# Defaults for the compose network (host names instead of localhost).
COPY docker/agentclient.appsettings.json agentclient-config/appsettings.json
USER app
ENTRYPOINT ["dotnet", "AgentClient.dll"]
