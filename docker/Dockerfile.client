# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Restore first (own layer) so source edits do not re-download packages.
COPY Directory.Build.props Directory.Packages.props global.json Ambinder.A2A.slnx ./
COPY proto/ proto/
COPY src/Directory.Build.props src/
COPY samples/Directory.Build.props samples/
COPY src/Ambinder.A2A.Protocol/Ambinder.A2A.Protocol.csproj src/Ambinder.A2A.Protocol/
COPY src/Ambinder.A2A.Server/Ambinder.A2A.Server.csproj src/Ambinder.A2A.Server/
COPY src/Ambinder.A2A.AspNetCore/Ambinder.A2A.AspNetCore.csproj src/Ambinder.A2A.AspNetCore/
COPY src/Ambinder.A2A.AspNetCore.Grpc/Ambinder.A2A.AspNetCore.Grpc.csproj src/Ambinder.A2A.AspNetCore.Grpc/
COPY src/Ambinder.A2A.Client/Ambinder.A2A.Client.csproj src/Ambinder.A2A.Client/
COPY src/Ambinder.A2A.Client.Grpc/Ambinder.A2A.Client.Grpc.csproj src/Ambinder.A2A.Client.Grpc/
COPY src/Ambinder.A2A.Client.Entra/Ambinder.A2A.Client.Entra.csproj src/Ambinder.A2A.Client.Entra/
COPY samples/AgentClient/AgentClient.csproj samples/AgentClient/
RUN dotnet restore samples/AgentClient/AgentClient.csproj
COPY . .
RUN dotnet publish samples/AgentClient/AgentClient.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/runtime:11.0 AS final
WORKDIR /app
COPY --from=build /out .
# Defaults for the compose network (host names instead of localhost).
COPY docker/agentclient.appsettings.json agentclient-config/appsettings.json
USER app
ENTRYPOINT ["dotnet", "Ambinder.A2A.Samples.AgentClient.dll"]
