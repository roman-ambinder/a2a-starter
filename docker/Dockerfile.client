# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish samples/AgentClient/AgentClient.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
COPY --from=build /out .
# Defaults for the compose network (host names instead of localhost).
COPY docker/agentclient.appsettings.json agentclient-config/appsettings.json
ENV ASPNETCORE_ENVIRONMENT=Development
USER app
ENTRYPOINT ["dotnet", "AgentClient.dll"]
