# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Restore first (own layer) so source edits do not re-download packages.
COPY Directory.Build.props Directory.Packages.props global.json A2A.Reference.slnx ./
COPY proto/ proto/
COPY src/A2A.Protocol/A2A.Protocol.csproj src/A2A.Protocol/
COPY src/A2A.Protocol.Grpc/A2A.Protocol.Grpc.csproj src/A2A.Protocol.Grpc/
COPY src/A2A.Server/A2A.Server.csproj src/A2A.Server/
COPY src/A2A.Client/A2A.Client.csproj src/A2A.Client/
COPY samples/MockEntra/MockEntra.csproj samples/MockEntra/
RUN dotnet restore samples/MockEntra/MockEntra.csproj
COPY . .
RUN dotnet publish samples/MockEntra/MockEntra.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# curl is only for the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# MockEntra refuses to run outside Development; the environment comes from compose (ASPNETCORE_ENVIRONMENT), not the image.
# appsettings.json sets "Urls" to localhost (it beats ASPNETCORE_URLS), so bind all interfaces here.
ENV Urls=http://0.0.0.0:5100
EXPOSE 5100
USER app
ENTRYPOINT ["dotnet", "MockEntra.dll"]
