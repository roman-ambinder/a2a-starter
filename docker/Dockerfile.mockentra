# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish samples/MockEntra/MockEntra.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# curl is only for the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# MockEntra refuses to run outside Development. appsettings.Development.json sets "Urls" to localhost (it beats ASPNETCORE_URLS), so bind all interfaces here.
ENV ASPNETCORE_ENVIRONMENT=Development \
    Urls=http://0.0.0.0:5100
EXPOSE 5100
USER app
ENTRYPOINT ["dotnet", "MockEntra.dll"]
