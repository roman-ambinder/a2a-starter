# Build context: repository root (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Restore first (own layer) so source edits do not re-download packages.
COPY Directory.Build.props Directory.Packages.props global.json Ambinder.A2A.slnx ./
COPY proto/ proto/
COPY samples/Directory.Build.props samples/
COPY src/Ambinder.A2A.Protocol/Ambinder.A2A.Protocol.csproj src/Ambinder.A2A.Protocol/
COPY src/Ambinder.A2A.Protocol.Grpc/Ambinder.A2A.Protocol.Grpc.csproj src/Ambinder.A2A.Protocol.Grpc/
COPY src/Ambinder.A2A.Server/Ambinder.A2A.Server.csproj src/Ambinder.A2A.Server/
COPY src/Ambinder.A2A.AspNetCore/Ambinder.A2A.AspNetCore.csproj src/Ambinder.A2A.AspNetCore/
COPY src/Ambinder.A2A.AspNetCore.Grpc/Ambinder.A2A.AspNetCore.Grpc.csproj src/Ambinder.A2A.AspNetCore.Grpc/
COPY src/Ambinder.A2A.Client/Ambinder.A2A.Client.csproj src/Ambinder.A2A.Client/
COPY samples/SampleTelemetry/SampleTelemetry.csproj samples/SampleTelemetry/
COPY samples/WebhookReceiver/WebhookReceiver.csproj samples/WebhookReceiver/
RUN dotnet restore samples/WebhookReceiver/WebhookReceiver.csproj
COPY . .
RUN dotnet publish samples/WebhookReceiver/WebhookReceiver.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# curl is only for the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# The environment comes from compose (ASPNETCORE_ENVIRONMENT), not the image.
ENV ASPNETCORE_URLS=http://0.0.0.0:5300
EXPOSE 5300
USER app
ENTRYPOINT ["dotnet", "Ambinder.A2A.Samples.WebhookReceiver.dll"]
