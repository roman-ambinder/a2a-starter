root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,slnx,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Registration and mapping extensions live in the namespaces the web SDK imports implicitly (spec 02 section 5).
[src/**/{*ServiceCollectionExtensions,*ServerBuilderExtensions,*EndpointRouteBuilderExtensions,A2AKestrelExtensions}.cs]
dotnet_diagnostic.IDE0130.severity = none
